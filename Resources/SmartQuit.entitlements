<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty.
	     SmartQuit runs under the hardened runtime with no exceptions: it loads
	     no plug-ins, generates no code, and reads no protected user data. The
	     Accessibility and Apple Events access it does need are granted by the
	     user at runtime through TCC, not by an entitlement.
	     The file exists so that set is stated rather than implied. -->
</dict>
</plist>
